# 开发环境编译期配置示例（配合 Flutter --dart-define-from-file 使用）
#
# 用法：
#   cp .env.dev.example .env.dev
#   flutter run -d chrome --dart-define-from-file=.env.dev
#
# 注意：
#   1. 值不要加引号，也不要在值末尾写行内 # 注释。
#   2. 这是编译期注入；修改后需重新运行或构建才会生效。
#   3. dev 环境下本地 shared_preferences 覆盖优先级高于本文件。

# 环境标识：dev | prod（debug/profile 构建默认 dev，可省略）
APP_ENV=dev

# 后端 API 地址（允许 http://）
# 默认值：Web/Windows 为 http://localhost:8000；Android 模拟器为 http://10.0.2.2:8000
# Android 真机请改为宿主机局域网地址，例如 http://192.168.1.100:8000
API_BASE_URL=http://localhost:8000

# OIDC / Keycloak Issuer，须与后端 KB_OIDC_ISSUER 逐字一致
# 留空或注释掉则进入无认证兼容模式（不弹登录页、不携带 Authorization 头）
OIDC_ISSUER=http://localhost:8180/realms/kb

# OIDC Public Client ID（使用 PKCE S256，默认 kb-web）
OIDC_CLIENT_ID=kb-web

# 可选：自定义回调地址（留空或注释则按平台自动选择：
#   Web:     <origin>/auth/callback
#   Windows: http://localhost:8182/auth/callback
#   Android: http://127.0.0.1:8182/auth/callback）
# OIDC_REDIRECT_URI=http://localhost:8080/auth/callback

# 可选：OIDC Scope（默认 openid，access token 须包含 sub）
# OIDC_SCOPES=openid
