# 生产环境编译期配置示例（配合 Flutter --dart-define-from-file 使用）
#
# 用法：
#   cp .env.prod.example .env.prod
#   # 编辑 .env.prod 填入真实地址，然后构建：
#   flutter build web --release --wasm --dart-define-from-file=.env.prod
#   flutter build apk --release --dart-define-from-file=.env.prod
#   flutter build windows --release --dart-define-from-file=.env.prod
#
# 注意：
#   1. 值不要加引号，也不要在值末尾写行内 # 注释。
#   2. prod 忽略本地 shared_preferences 覆盖，且强制要求：
#      - API_BASE_URL 必须为非空 https:// 地址
#      - OIDC_ISSUER 必须非空（禁止无认证兼容模式）
#      任一不满足时应用启动阶段会直接抛出 StateError（fail-fast）。

# 环境标识：release 构建默认 prod，显式声明可避免误用
APP_ENV=prod

# 必填：生产后端 API 地址（必须为 https://）
API_BASE_URL=https://kb.example.com

# 必填：生产 OIDC / Keycloak Issuer（须与后端 KB_OIDC_ISSUER 逐字一致）
OIDC_ISSUER=https://auth.example.com/realms/kb

# OIDC Public Client ID（默认 kb-web）
OIDC_CLIENT_ID=kb-web

# 可选：自定义回调地址（不填则按平台默认：Web <origin>/auth/callback，
# Windows http://localhost:8182/auth/callback，Android http://127.0.0.1:8182/auth/callback）
# OIDC_REDIRECT_URI=https://app.example.com/auth/callback

# 可选：OIDC Scope（默认 openid）
# OIDC_SCOPES=openid
