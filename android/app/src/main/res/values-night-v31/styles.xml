<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ system splash screen (night): light line-art glyph on the
     dark surface (drawable-night-*/ic_launcher_splash.png is picked by the
     night qualifier). -->
<resources>
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">#171A22</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher_splash</item>
    </style>
    <!-- Theme applied to the Android Window as soon as the process has
         started. This theme determines the color of the Android Window
         while your Flutter UI initializes, as well as behind your Flutter
         UI while its running. -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
